{
  "name": "PRAHARI — SIF Precursor Intelligence",
  "short_name": "PRAHARI",
  "description": "Report unsafe acts, unsafe conditions and near misses, and see their serious-injury potential.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#09090b",
