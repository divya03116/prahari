# ---------------------------------------------------------------------------
# PRAHARI web app configuration. Copy to .env and fill in.
#
# These are the PUBLIC identifiers of your Firebase web app (Firebase console →
# Project settings → General → Your apps → Web app → SDK setup). They are not
# secrets: every visitor's browser receives them. Access is enforced by
# Firebase Auth, firestore.rules, storage.rules and the Cloud Functions.
#
# Never put a service-account key, admin credential or API secret in any
# VITE_* variable — everything prefixed VITE_ is bundled into the browser.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must equal FUNCTIONS_REGION in functions/src/shared/constants.ts. A mismatch
# shows up in the browser as a CORS error on every write.
VITE_FUNCTIONS_REGION=us-central1

# true  → connect to the local emulator suite (npm run emulators).
# false → connect to the real project above.
VITE_USE_EMULATORS=false

# PPE inference service (ai/inference_service/server.py). Leave empty and the
# live-monitoring page shows "AI Model Not Configured". In production, also add
# this origin to connect-src in the Content-Security-Policy in firebase.json.
VITE_PPE_INFERENCE_URL=
# Optional shared secret, matching PPE_TOKEN on the service.
VITE_PPE_INFERENCE_TOKEN=

# --- Local emulator values (use instead of the above for local development) ---
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-prahari.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-prahari
# VITE_FIREBASE_STORAGE_BUCKET=demo-prahari.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# VITE_USE_EMULATORS=true
# VITE_PPE_INFERENCE_URL=http://127.0.0.1:8765
